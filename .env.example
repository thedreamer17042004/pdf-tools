# PostgreSQL
POSTGRES_USER=acman
POSTGRES_PASSWORD=acman_dev_password
POSTGRES_DB=acman
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6379

# Object storage (FileSystem default; set Storage__Provider=S3 for LocalStack)
Storage__Provider=FileSystem
Storage__FileSystemRoot=data/objects
Storage__Endpoint=http://localhost:4566
Storage__AccessKey=test
Storage__SecretKey=test
Storage__Bucket=acman-documents
Storage__ForcePathStyle=true


# RabbitMQ
RABBITMQ_USER=acman
RABBITMQ_PASSWORD=acman_rabbit_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# API
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
ConnectionStrings__Database=Host=localhost;Port=5433;Database=acman;Username=acman;Password=acman_dev_password
ConnectionStrings__Redis=localhost:6379
Storage__Endpoint=http://localhost:9000
Storage__AccessKey=acmanminio
Storage__SecretKey=acman_minio_secret
Storage__Bucket=acman-documents
Storage__ForcePathStyle=true
Documents__MaxUploadBytes=52428800

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:5080
