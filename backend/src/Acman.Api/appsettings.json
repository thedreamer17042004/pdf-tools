{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5433;Database=acman;Username=acman;Password=acman_dev_password",
    "Redis": "localhost:6379"
  },
  "Storage": {
    "Provider": "FileSystem",
    "FileSystemRoot": "../../../data/objects",
    "Endpoint": "http://localhost:4566",
    "AccessKey": "test",
    "SecretKey": "test",
    "Bucket": "acman-documents",
    "ForcePathStyle": true,
    "Region": "us-east-1"
  },
  "Documents": {
    "MaxUploadBytes": 52428800,
    "RenderCacheTtl": "00:30:00"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "nam-dev",
    "Audience": "nam-dev-web",
    "SigningKey": "nam-dev-signing-key-change-me-32chars!",
    "ExpiryMinutes": 480
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "acman",
    "Password": "acman_rabbit_password",
    "QueueName": "acman.processing.jobs"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "AllowedHosts": "*"
}
